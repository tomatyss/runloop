#!/bin/sh
set -e

STATE_FILE="/run/runloopd.was-active"

is_systemd() {
	if [ -d /run/systemd/system ]; then
		return 0
	else
		return 1
	fi
}

create_runloop_user() {
	if ! getent group runloop >/dev/null 2>&1; then
		addgroup --system --quiet runloop
	fi
	if ! id -u runloop >/dev/null 2>&1; then
		adduser \
			--system \
			--ingroup runloop \
			--home /var/lib/runloop \
			--no-create-home \
			--shell /usr/sbin/nologin \
			--quiet \
			runloop
	fi
}

setup_directories() {
	install -d -o runloop -g runloop -m 2775 /var/lib/runloop
	install -d -o runloop -g runloop -m 2775 /var/lib/runloop/agents
	install -d -o runloop -g runloop -m 2775 /var/lib/runloop/openings
	install -d -o runloop -g runloop -m 2775 /var/lib/runloop/pog
	install -d -o runloop -g runloop -m 2775 /var/lib/runloop/pog/vectors
	install -d -o runloop -g runloop -m 2775 /var/log/runloop
	chmod 2775 /var/lib/runloop /var/lib/runloop/agents /var/lib/runloop/openings \
		/var/lib/runloop/pog /var/lib/runloop/pog/vectors /var/log/runloop || true
}

hash_file() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | awk '{print $1}'
	elif command -v shasum >/dev/null 2>&1; then
		shasum -a 256 "$1" | awk '{print $1}'
	else
		return 1
	fi
}

hash_stream() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum | awk '{print $1}'
	elif command -v shasum >/dev/null 2>&1; then
		shasum -a 256 | awk '{print $1}'
	else
		return 1
	fi
}

hash_dir() {
	dir="$1"
	if [ ! -d "$dir" ]; then
		return 1
	fi
	(
		cd "$dir" || exit 1
		find . -type f -print 2>/dev/null | LC_ALL=C sort | while IFS= read -r file; do
			hash="$(hash_file "$file" 2>/dev/null || true)"
			if [ -n "$hash" ]; then
				printf '%s  %s\n' "$hash" "$file"
			fi
		done | hash_stream
	)
}

write_seed_dir_hash() {
	seed="$1"
	dir="$2"
	hash="$(hash_dir "$dir" 2>/dev/null || true)"
	if [ -n "$hash" ]; then
		printf 'dir:%s\n' "$hash" > "$seed" 2>/dev/null || true
	fi
}

seed_dir_if_matches_src() {
	seed="$1"
	dest="$2"
	src="$3"
	current="$(hash_dir "$dest" 2>/dev/null || true)"
	src_hash="$(hash_dir "$src" 2>/dev/null || true)"
	if [ -n "$current" ] && [ -n "$src_hash" ]; then
		if [ "$current" = "$src_hash" ]; then
			write_seed_dir_hash "$seed" "$dest"
		fi
	fi
}

seed_opening() {
	src="$1"
	dest="$2"
	seed="$3"
	if [ ! -f "$src" ]; then
		return
	fi
	if [ ! -f "$dest" ]; then
		install -o runloop -g runloop -m 0664 "$src" "$dest"
		hash_file "$dest" > "$seed" 2>/dev/null || true
		return
	fi
	if [ ! -f "$seed" ]; then
		current="$(hash_file "$dest" 2>/dev/null || true)"
		src_hash="$(hash_file "$src" 2>/dev/null || true)"
		if [ -n "$current" ] && [ "$current" = "$src_hash" ]; then
			hash_file "$dest" > "$seed" 2>/dev/null || true
		fi
		return
	fi
	if [ -f "$seed" ]; then
		current="$(hash_file "$dest" 2>/dev/null || true)"
		seeded="$(cat "$seed" 2>/dev/null || true)"
		if [ -n "$current" ] && [ "$current" = "$seeded" ]; then
			install -o runloop -g runloop -m 0664 "$src" "$dest"
			hash_file "$dest" > "$seed" 2>/dev/null || true
		fi
	fi
}

seed_agent_dir() {
	src="$1"
	dest="$2"
	seed="$3"
	manifest_dest="$dest/manifest.toml"
	if [ ! -d "$src" ]; then
		return
	fi
	if [ ! -d "$dest" ]; then
		cp -a "$src" "$dest"
		chown -R runloop:runloop "$dest"
		chmod -R g+w "$dest"
		write_seed_dir_hash "$seed" "$dest"
		return
	fi
	if [ ! -f "$manifest_dest" ]; then
		return
	fi
	if [ ! -f "$seed" ]; then
		seed_dir_if_matches_src "$seed" "$dest" "$src"
		return
	fi
	seeded_line="$(head -n 1 "$seed" 2>/dev/null || true)"
	case "$seeded_line" in
		dir:*)
			seeded="${seeded_line#dir:}"
			current="$(hash_dir "$dest" 2>/dev/null || true)"
			if [ -n "$current" ] && [ "$current" = "$seeded" ]; then
				rm -rf "$dest"
				cp -a "$src" "$dest"
				chown -R runloop:runloop "$dest"
				chmod -R g+w "$dest"
				write_seed_dir_hash "$seed" "$dest"
			fi
			;;
		*)
			seed_dir_if_matches_src "$seed" "$dest" "$src"
			;;
	esac
}

seed_default_content() {
	seed_agents_dir="/var/lib/runloop/agents/.seeded"
	seed_openings_dir="/var/lib/runloop/openings/.seeded"
	install -d -o runloop -g runloop -m 2775 "$seed_agents_dir"
	install -d -o runloop -g runloop -m 2775 "$seed_openings_dir"
	chmod 2775 "$seed_agents_dir" "$seed_openings_dir" || true

	seed_opening \
		"/etc/runloop/openings/compose_email.yaml" \
		"/var/lib/runloop/openings/compose_email.yaml" \
		"$seed_openings_dir/compose_email.sha256"
	seed_opening \
		"/etc/runloop/openings/smoke_exec.yaml" \
		"/var/lib/runloop/openings/smoke_exec.yaml" \
		"$seed_openings_dir/smoke_exec.sha256"

	if [ -d /usr/lib/runloop/agents ]; then
		for agent_dir in /usr/lib/runloop/agents/*; do
			if [ ! -d "$agent_dir" ]; then
				continue
			fi
			agent_name=$(basename "$agent_dir")
			seed_agent_dir \
				"$agent_dir" \
				"/var/lib/runloop/agents/$agent_name" \
				"$seed_agents_dir/$agent_name.sha256"
		done
	fi
}

set_config_permissions() {
	if [ -f /etc/runloop/config.yaml ]; then
		chown root:runloop /etc/runloop/config.yaml
		chmod 0640 /etc/runloop/config.yaml
	fi
}

start_if_previously_running() {
	if [ ! -f "$STATE_FILE" ]; then
		return
	fi

	if is_systemd; then
		systemctl start runloopd.service >/dev/null 2>&1 || true
	fi

	rm -f "$STATE_FILE"
}

clear_state_file() {
	rm -f "$STATE_FILE"
}

case "$1" in
	configure)
		create_runloop_user
		setup_directories
		seed_default_content
		set_config_permissions
		if command -v systemd-tmpfiles >/dev/null 2>&1; then
			systemd-tmpfiles --create /usr/lib/tmpfiles.d/runloop.conf >/dev/null 2>&1 || true
		fi
		if is_systemd; then
			systemctl daemon-reload >/dev/null 2>&1 || true
			systemctl enable runloopd.service >/dev/null 2>&1 || true
		fi
		start_if_previously_running
		;;
	abort-upgrade|abort-remove|abort-deconfigure)
		clear_state_file
		;;
esac

exit 0

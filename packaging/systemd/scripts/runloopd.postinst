#!/bin/sh
set -e

STATE_FILE="/run/runloopd.was-active"

is_systemd() {
	if [ -d /run/systemd/system ]; then
		return 0
	else
		return 1
	fi
}

create_runloop_user() {
	if ! getent group runloop >/dev/null 2>&1; then
		addgroup --system --quiet runloop
	fi
	if ! id -u runloop >/dev/null 2>&1; then
		adduser \
			--system \
			--ingroup runloop \
			--home /var/lib/runloop \
			--no-create-home \
			--shell /usr/sbin/nologin \
			--quiet \
			runloop
	fi
}

setup_directories() {
	install -d -o runloop -g runloop -m 0750 /var/lib/runloop
	install -d -o runloop -g runloop -m 0750 /var/lib/runloop/pog
	install -d -o runloop -g runloop -m 0750 /var/lib/runloop/pog/vectors
	install -d -o runloop -g runloop -m 0750 /var/log/runloop
}

set_config_permissions() {
	if [ -f /etc/runloop/config.yaml ]; then
		chown root:runloop /etc/runloop/config.yaml
		chmod 0640 /etc/runloop/config.yaml
	fi
}

start_if_previously_running() {
	if [ ! -f "$STATE_FILE" ]; then
		return
	fi

	if is_systemd; then
		systemctl start runloopd.service >/dev/null 2>&1 || true
	fi

	rm -f "$STATE_FILE"
}

clear_state_file() {
	rm -f "$STATE_FILE"
}

case "$1" in
	configure)
		create_runloop_user
		setup_directories
		set_config_permissions
		if command -v systemd-tmpfiles >/dev/null 2>&1; then
			systemd-tmpfiles --create /usr/lib/tmpfiles.d/runloop.conf >/dev/null 2>&1 || true
		fi
		if is_systemd; then
			systemctl daemon-reload >/dev/null 2>&1 || true
			systemctl enable runloopd.service >/dev/null 2>&1 || true
		fi
		start_if_previously_running
		;;
	abort-upgrade|abort-remove|abort-deconfigure)
		clear_state_file
		;;
esac

exit 0

#!/bin/sh
set -e

STATE_FILE="/run/runloopd.was-active"

is_systemd() {
	if [ -d /run/systemd/system ]; then
		return 0
	else
		return 1
	fi
}

cleanup_state() {
	rm -rf /var/lib/runloop /var/log/runloop
	if [ -d /etc/runloop ]; then
		rm -rf /etc/runloop
	fi
	if getent passwd runloop >/dev/null 2>&1; then
		deluser --system --quiet runloop || true
	fi
	if getent group runloop >/dev/null 2>&1; then
		delgroup --quiet runloop || true
	fi
}

clear_restart_state() {
	rm -f "$STATE_FILE"
}

case "$1" in
	remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
		if is_systemd; then
			systemctl daemon-reload >/dev/null 2>&1 || true
		fi
		;;
	purge)
		if is_systemd; then
			systemctl disable runloopd.service >/dev/null 2>&1 || true
			systemctl daemon-reload >/dev/null 2>&1 || true
		fi
		cleanup_state
		;;
esac

clear_restart_state

exit 0

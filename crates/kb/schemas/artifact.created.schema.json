{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runloop.local/schemas/artifact.created.schema.json",
  "$anchor": "v1",
  "title": "artifact.created v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "path", "sha256"],
  "properties": {
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "summary": {
      "type": "string"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    }
  }
}

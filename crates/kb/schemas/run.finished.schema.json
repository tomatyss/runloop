{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runloop.local/schemas/run.finished.schema.json#v1",
  "title": "run.finished v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["opening_id", "status"],
  "properties": {
    "opening_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["finished", "failed", "cancelled"]
    }
  }
}

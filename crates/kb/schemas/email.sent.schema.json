{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runloop.local/schemas/email.sent.schema.json",
  "$anchor": "v1",
  "title": "email.sent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["to", "subject", "artifact_id"],
  "properties": {
    "to": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "email"
      }
    },
    "cc": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      }
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "integer",
      "minimum": 1
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "delivered_at_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}

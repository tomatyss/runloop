#!/usr/bin/env python3
"""
Deterministic contact resolver used by the compose_email demo opening.

This native shim emulates the future WASM agent by looking up a contact from
a small in-repo roster and printing the resolved contact as JSON to stdout.
"""
from __future__ import annotations

import argparse
import json
import sys
import textwrap
import uuid

CONTACTS = [
    {
        "contact_id": "contact:john-smith",
        "name": "John Smith",
        "email": "john@acme.com",
        "org": "Acme Corp",
        "confidence": 0.93,
        "notes": "Primary stakeholder for Q4 planning.",
    },
    {
        "contact_id": "contact:maria-lee",
        "name": "Maria Lee",
        "email": "maria@acme.com",
        "org": "Acme Corp",
        "confidence": 0.88,
        "notes": "Finance lead for Acme.",
    },
    {
        "contact_id": "contact:dev-rel",
        "name": "Dev Rel Alias",
        "email": "devrel@runloop.local",
        "org": "Runloop",
        "confidence": 0.65,
        "notes": "Fallback auto-generated contact.",
    },
]


def slug(value: str) -> str:
    base = "".join(ch if ch.isalnum() else "-" for ch in value.strip().lower())
    return "-".join(part for part in base.split("-") if part)


def build_stub(query: str) -> dict:
    identifier = slug(query) or uuid.uuid4().hex[:8]
    name = query if "@" not in query else query.split("@", 1)[0]
    email = query if "@" in query else f"{identifier}@unknown.local"
    return {
        "contact_id": f"contact:{identifier}",
        "name": name.title(),
        "email": email.lower(),
        "org": None,
        "confidence": 0.4,
        "notes": "Auto-generated stub contact",
    }


def match_contact(query: str) -> dict:
    q = query.strip().lower()
    if not q:
        raise SystemExit("contact_resolver: --query must not be empty")
    for contact in CONTACTS:
        if q in contact["name"].lower() or q in contact["email"].lower():
            return contact
    return build_stub(query)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="contact_resolver",
        formatter_class=argparse.RawTextHelpFormatter,
        description=textwrap.dedent(
            """Resolve a contact from the in-repo roster.

            Example:
              agents/contact_resolver/bin/contact_resolver --query "john"
            """
        ),
    )
    parser.add_argument("--query", required=True, help="Name or email to search for.")
    args = parser.parse_args(argv)

    contact = match_contact(args.query)
    contact["last_event_id"] = None
    print(json.dumps(contact, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

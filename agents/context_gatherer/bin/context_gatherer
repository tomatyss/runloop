#!/usr/bin/env python3
"""
Context gatherer shim for the compose_email sample opening.

This script fabricates a lightweight context bundle for the requested topic.
"""
from __future__ import annotations

import argparse
import json
import sys
from datetime import UTC, datetime


def build_snippets(topic: str, contact_name: str | None) -> list[dict]:
    now = datetime.now(tz=UTC).strftime("%Y-%m-%d")
    bullets = [
        {
            "title": f"{topic} planning sync ({now})",
            "excerpt": (
                f"Team aligned on {topic.lower()} milestones during the weekly sync."
            ),
            "event_id": 1,
        },
        {
            "title": "Action items",
            "excerpt": "Finalize roadmap draft and confirm headcount adjustments.",
            "event_id": 2,
        },
    ]
    if contact_name:
        bullets.append(
            {
                "title": "Relationship note",
                "excerpt": f"{contact_name} prefers concise status updates.",
                "event_id": 3,
            }
        )
    return bullets


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Generate a context bundle.")
    parser.add_argument("--topic", required=True, help="Topic we are summarizing.")
    parser.add_argument(
        "--contact-json",
        help="Optional path to a JSON file containing the resolved contact.",
    )
    args = parser.parse_args(argv)

    contact_name = None
    if args.contact_json:
        try:
            with open(args.contact_json, "r", encoding="utf-8") as fh:
                contact = json.load(fh)
                contact_name = contact.get("name")
        except OSError as exc:
            raise SystemExit(f"failed to read contact JSON: {exc}") from exc

    bundle = {
        "topic": args.topic,
        "snippets": build_snippets(args.topic, contact_name),
    }
    print(json.dumps(bundle, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
